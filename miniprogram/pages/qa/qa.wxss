.qa-container { height: 100vh; display: flex; flex-direction: column; padding-bottom: 140rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.template-scroll { white-space: nowrap; width: 100%; height: 140rpx; margin-bottom: 10rpx; }
.template-card { display: inline-block; width: 280rpx; height: 120rpx; padding: 20rpx; border-radius: 20rpx; margin-right: 20rpx; color: #fff; box-shadow: 0 8rpx 16rpx rgba(86,165,236,0.3); vertical-align: top; white-space: normal; }
.t-name { font-size: 26rpx; font-weight: bold; display: block; margin-bottom: 10rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.t-down { font-size: 22rpx; opacity: 0.8; }
.empty-text { font-size: 26rpx; color: #999; display: inline-block; padding: 40rpx; }

.chat-area { flex: 1; padding: 20rpx; overflow-y: scroll; margin-bottom: 20rpx; }
.message { display: flex; margin-bottom: 30rpx; width: 100%; }
.msg-user { justify-content: flex-end; }
.msg-ai { justify-content: flex-start; }
.msg-bubble { max-width: 80%; padding: 20rpx 30rpx; border-radius: 24rpx; font-size: 28rpx; line-height: 1.5; word-wrap: break-word; }
.bg-primary { background: var(--c-primary); color: #fff; border-bottom-right-radius: 4rpx; }
.bg-white { background: #f5f7fa; color: #333; border-bottom-left-radius: 4rpx; border: 1px solid #eee; }

.input-area { position: fixed; bottom: 0; left: 0; width: 100%; padding: 20rpx 30rpx; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; border-radius: 32rpx 32rpx 0 0; z-index: 100; }
.chat-input { flex: 1; height: 80rpx; background: #f0f2f5; border-radius: 40rpx; padding: 0 30rpx; font-size: 28rpx; margin-right: 20rpx; }
.send-btn { width: 156rpx !important; height: 80rpx; line-height: 80rpx; font-size: 28rpx; color: #fff; padding: 0; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; }
.send-icon { font-size: 28rpx; line-height: 1; margin-right: 8rpx; transform: translateY(-1rpx); }
.send-text { font-size: 26rpx; line-height: 1; }