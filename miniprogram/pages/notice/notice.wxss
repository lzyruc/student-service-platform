.notice-item {
  padding: 30rpx;
}
.n-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.n-tag {
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.n-time {
  font-size: 24rpx;
  color: #999;
}
.n-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  line-height: 1.4;
}
.n-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.n-attachment {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f7f9fc;
  border: 1rpx solid #e6ebf2;
  border-radius: 8rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
}
.attach-icon {
  font-size: 34rpx;
  line-height: 1;
}
.attach-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.attach-name {
  font-size: 26rpx;
  color: #263447;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.attach-meta {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a96a8;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.n-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px dashed #eee;
  padding-top: 20rpx;
}
.n-status {
  font-size: 24rpx;
  font-weight: bold;
}
.n-status.read {
  color: #ccc;
}
.n-status.unread {
  color: var(--c-primary);
}
.n-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.btn-mini {
  margin: 0;
  height: 50rpx;
  line-height: 50rpx;
  font-size: 24rpx;
  color: #fff;
  padding: 0 20rpx;
  border-radius: 25rpx;
}
.btn-detail {
  background: #eef4ff;
  color: var(--c-primary);
}

.n-tag {
  background: #eef2ff;
  color: #617ac1;
  border-radius: 6rpx;
  padding: 7rpx 14rpx;
  font-size: 20rpx;
}
.n-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #33445f;
}
.n-time {
  font-size: 20rpx;
  color: #9da9bb;
}
.n-desc {
  color: #8a98af;
  font-size: 24rpx;
  line-height: 1.8;
}
.n-footer {
  border-top: 1rpx solid #edf0f7;
}
.btn-mini {
  border-radius: 10rpx;
  font-size: 21rpx;
}
.btn-detail {
  background: #f1f4fb;
  color: #7283b7;
}
.n-status.read {
  color: #78988c;
}
.empty-hint {
  padding: 56rpx 24rpx;
  text-align: center;
  color: #94a0b5;
  line-height: 2;
  font-size: 25rpx;
}
.urgent-badge {
  color: #b46358;
  background: #fff0eb;
  padding: 4rpx 10rpx;
  border-radius: 5rpx;
  font-size: 20rpx;
}
