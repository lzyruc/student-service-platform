.header { margin-bottom: 40rpx; padding-top: 20rpx; }
.title { font-size: 56rpx; font-weight: 800; color: #1a1a1a; letter-spacing: 2rpx; }
.subtitle { font-size: 28rpx; color: #888; margin-top: 10rpx; }
.service-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.service-item { width: 47%; height: 260rpx; border-radius: 36rpx; margin-bottom: 30rpx; position: relative; overflow: hidden; box-shadow: 0 16rpx 30rpx rgba(21, 125, 236, 0.2); transition: transform 0.2s; }
.service-item:active { transform: scale(0.96); }
.full-width { width: 100%; height: 200rpx; }
.grad-1 { background: var(--grad-1); }
.grad-2 { background: var(--grad-2); }
.grad-3 { background: var(--grad-3); }
.grad-4 { background: var(--grad-4); }
.item-content { width: 100%; height: 100%; padding: 30rpx; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; }
.row-content { flex-direction: row; align-items: center; }
.item-title { color: #fff; font-size: 34rpx; font-weight: bold; line-height: 1.4; text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1); }
.icon-circle { width: 64rpx; height: 64rpx; background: rgba(255,255,255,0.25); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; backdrop-filter: blur(10px); align-self: flex-end; }