.home-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #425bd8;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.student-badge {
  font-size: 18rpx;
  color: #7f8ca3;
  padding: 8rpx 12rpx;
  border: 1rpx solid #e0e6f1;
  border-radius: 8rpx;
}
.home-heading {
  margin: 56rpx 0 36rpx;
}
.home-heading .page-title {
  font-size: 42rpx;
}
.section-label {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}
.section-caption {
  font-size: 20rpx;
  color: #8f9bb0;
  font-weight: 400;
}
.service-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.service-item {
  padding: 28rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  position: relative;
  background: #fff;
  border: 1rpx solid #e5ebf4;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 80, 0.02);
}
.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #eef2ff;
  color: #425bd8;
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.icon-teal {
  background: #edf7f4;
  color: #358b78;
}
.icon-sand {
  background: #fff5e9;
  color: #bb8749;
}
.item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.item-description {
  font-size: 22rpx;
  color: #8b96a9;
}
.item-arrow {
  position: absolute;
  right: 26rpx;
  top: 28rpx;
  font-size: 26rpx;
  color: #bac3d2;
}
.agent-entry {
  margin-top: 30rpx;
  padding: 32rpx;
  border: 1rpx solid #dbe1f6;
  border-radius: 26rpx;
  background: linear-gradient(130deg, #edf1ff, #f6f7fe);
  color: #243661;
}
.agent-entry-top,
.agent-entry-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ai-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  color: #526bc7;
}
.agent-entry-arrow {
  font-size: 30rpx;
  color: #687fd1;
}
.agent-entry-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin: 22rpx 0 12rpx;
}
.agent-entry-subtitle {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: #8390ae;
}
.agent-entry-bottom {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #dfe5f6;
  font-size: 19rpx;
  color: #8a96b1;
}
.agent-entry-action {
  color: #425bd8;
  font-weight: 600;
}
.home-footnote {
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: 20rpx;
  color: #9aa5b8;
  margin: 30rpx 0;
  line-height: 1.7;
}
.footnote-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #96a6d4;
}
.card-pressed {
  opacity: 0.85;
  transform: translateY(2rpx);
}
