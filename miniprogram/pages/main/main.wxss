.home-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.home-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: #d92332;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.student-badge {
  font-size: 18rpx;
  color: #7f8ca3;
  padding: 8rpx 12rpx;
  border: 1rpx solid #e0e6f1;
  border-radius: 8rpx;
}
.home-heading {
  margin: 56rpx 0 36rpx;
}
.home-heading .page-title {
  font-size: 42rpx;
}
.section-label {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 22rpx;
}
.section-caption {
  font-size: 20rpx;
  color: #8f9bb0;
  font-weight: 400;
}
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}
.service-item {
  padding: 24rpx 18rpx;
  min-height: 210rpx;
  box-sizing: border-box;
  position: relative;
  background: #fff;
  border: 1rpx solid #efdfd9;
  border-radius: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 80, 0.02);
}
.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #fff0ec;
  color: #d92332;
  font-size: 36rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}
.icon-teal {
  background: #edf7f4;
  color: #358b78;
}
.icon-sand {
  background: #fff5e9;
  color: #bb8749;
}
.item-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.item-description {
  font-size: 22rpx;
  color: #82716b;
}
.item-arrow {
  position: absolute;
  right: 26rpx;
  top: 28rpx;
  font-size: 26rpx;
  color: #bac3d2;
}
.agent-entry {
  margin-top: 30rpx;
  padding: 32rpx;
  border: 1rpx solid #f4d4cc;
  border-radius: 26rpx;
  background: #d92332;
  color: #fff;
}
.agent-entry-top,
.agent-entry-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.ai-label {
  font-size: 18rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
  color: #b51b2c;
}
.agent-entry-arrow {
  font-size: 30rpx;
  color: #d92332;
}
.agent-entry-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  margin: 22rpx 0 12rpx;
}
.agent-entry-subtitle {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: #82716b;
}
.agent-entry-bottom {
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0d8d1;
  font-size: 19rpx;
  color: #82716b;
}
.agent-entry-action {
  color: #d92332;
  font-weight: 600;
}
.home-footnote {
  display: flex;
  gap: 10rpx;
  align-items: center;
  font-size: 20rpx;
  color: #9aa5b8;
  margin: 30rpx 0;
  line-height: 1.7;
}
.footnote-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #d92332;
}
.card-pressed {
  opacity: 0.85;
  transform: translateY(2rpx);
}

.agent-entry { border: 0; box-shadow: 0 10rpx 24rpx rgba(190, 25, 42, .12); }
.agent-entry .ai-label, .agent-entry-arrow, .agent-entry-action { color: #fff; }
.agent-entry .agent-entry-subtitle, .agent-entry .agent-entry-bottom { color: #ffe1d9; }
.agent-entry .agent-entry-bottom { border-color: rgba(255,255,255,.28); }
.item-title { font-size: 27rpx; }
.item-description { font-size: 21rpx; }
.home-heading { margin: 48rpx 0 32rpx; }
