<view class="container">
  <view class="header">
    <view class="title">服务大厅</view>
    <view class="subtitle">欢迎开启智慧校园服务</view>
  </view>

  <view class="service-grid">
    <view class="service-item grad-1" bindtap="navTo" data-url="/pages/qa/qa">
      <view class="item-content">
        <text class="item-title">智能问答\n政策库</text>
        <view class="icon-circle">🤖</view>
      </view>
    </view>
    <view class="service-item grad-3" bindtap="navTo" data-url="/pages/notice/notice">
      <view class="item-content">
        <text class="item-title">信息推送\n精准集成</text>
        <view class="icon-circle">🔔</view>
      </view>
    </view>
    <view class="service-item grad-4" bindtap="navTo" data-url="/pages/cert/cert">
      <view class="item-content">
        <text class="item-title">电子证明\n生成审批</text>
        <view class="icon-circle">📄</view>
      </view>
    </view>
    <view class="service-item grad-1" bindtap="navTo" data-url="/pages/academic/academic">
      <view class="item-content">
        <text class="item-title">学业分析\n风险预警</text>
        <view class="icon-circle">🎓</view>
      </view>
    </view>
  </view>
  <view class="agent-entry" bindtap="navTo" data-url="/pages/agent/agent" hover-class="agent-entry-pressed">
    <view class="agent-entry-icon">✦</view>
    <view class="agent-entry-content">
      <text class="agent-entry-title">学业智能助手</text>
      <text class="agent-entry-subtitle">聊聊学习情况、课程表现和成绩趋势</text>
    </view>
    <text class="agent-entry-arrow">›</text>
  </view>
</view>
