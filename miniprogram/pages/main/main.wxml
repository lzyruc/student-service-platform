<view class="container home-page">
  <view class="home-topline"><view class="home-brand"><text class="brand-mark">学</text><text>学生综合服务平台</text></view><text class="student-badge">学生端</text></view>
  <view class="home-heading"><text class="page-eyebrow">校园服务</text><text class="page-title">同学，你好。</text><text class="page-description">查通知、办证明，查看自己的学业情况。</text></view>
  <view class="section-label"><text>常用服务</text></view>
  <view class="service-grid">
    <view class="service-item" bindtap="navTo" data-url="/pages/notice/notice" hover-class="card-pressed"><text class="service-icon">≡</text><text class="item-title">校园通知</text><text class="item-description">查看与确认</text></view>
    <view class="service-item" bindtap="navTo" data-url="/pages/cert/cert" hover-class="card-pressed"><text class="service-icon icon-sand">▤</text><text class="item-title">电子证明</text><text class="item-description">申请与下载</text></view>
    <view class="service-item" bindtap="navTo" data-url="/pages/academic/academic" hover-class="card-pressed"><text class="service-icon icon-teal">↗</text><text class="item-title">课程分析</text><text class="item-description">成绩与学分</text></view>
  </view>
  <view class="agent-entry" bindtap="navTo" data-url="/pages/agent/agent" hover-class="card-pressed">
    <view class="agent-entry-top"><text class="ai-label">校园助手</text><text class="agent-entry-arrow">↗</text></view>
    <text class="agent-entry-title">学业与政策，在这里问。</text>
    <text class="agent-entry-subtitle">了解成绩趋势，查找校规和办事依据。</text>
    <view class="agent-entry-bottom"><text>支持连续追问</text><text class="agent-entry-action">开始对话 →</text></view>
  </view>
  <view class="home-footnote"><text class="footnote-dot"></text><text>成绩单保存后，可直接进行课程分析。</text></view>
</view>
