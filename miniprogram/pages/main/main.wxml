<view class="container home-page"
  ><view class="home-topline"
    ><view class="home-brand"
      ><text class="brand-mark">✦</text><text>学生综合服务平台</text></view
    ><text class="student-badge">学生工作台</text></view
  ><view class="home-heading"
    ><text class="page-eyebrow">YOUR CAMPUS, CONNECTED</text
    ><text class="page-title">今天，需要哪一项服务？</text
    ><text class="page-description">从学业到事务，每一步都更清晰。</text></view
  ><view class="section-label"
    ><text>校园服务</text><text class="section-caption">常用功能</text></view
  ><view class="service-grid"
    ><view
      class="service-item"
      bindtap="navTo"
      data-url="/pages/qa/qa"
      hover-class="card-pressed"
      ><text class="service-icon">?</text
      ><text class="item-title">政策问答</text
      ><text class="item-description">查政策，找依据</text
      ><text class="item-arrow">↗</text></view
    ><view
      class="service-item"
      bindtap="navTo"
      data-url="/pages/notice/notice"
      hover-class="card-pressed"
      ><text class="service-icon icon-teal">≡</text
      ><text class="item-title">校园通知</text
      ><text class="item-description">查看与确认通知</text
      ><text class="item-arrow">↗</text></view
    ><view
      class="service-item"
      bindtap="navTo"
      data-url="/pages/cert/cert"
      hover-class="card-pressed"
      ><text class="service-icon icon-sand">▤</text
      ><text class="item-title">电子证明</text
      ><text class="item-description">申请、审核与下载</text
      ><text class="item-arrow">↗</text></view
    ><view
      class="service-item"
      bindtap="navTo"
      data-url="/pages/academic/academic"
      hover-class="card-pressed"
      ><text class="service-icon">↗</text
      ><text class="item-title">课程分析</text
      ><text class="item-description">成绩单与学业报告</text
      ><text class="item-arrow">↗</text></view
    ></view
  ><view
    class="agent-entry"
    bindtap="navTo"
    data-url="/pages/agent/agent"
    hover-class="card-pressed"
    ><view class="agent-entry-top"
      ><text class="ai-label">ACADEMIC AGENT</text
      ><text class="agent-entry-arrow">↗</text></view
    ><text class="agent-entry-title">把学业问题，交给智能助手</text
    ><text class="agent-entry-subtitle"
      >了解课程表现与成绩趋势，查看真实分析过程。</text
    ><view class="agent-entry-bottom"
      ><text>基于你的成绩单与培养方案</text
      ><text class="agent-entry-action">开始对话 →</text></view
    ></view
  ><view class="home-footnote"
    ><text class="footnote-dot"></text
    ><text>成绩单上传一次，后续分析直接使用已保存文件</text></view
  ></view
>
