.login-container {
  min-height: 100vh;
  padding: 64rpx 40rpx;
  background: #f5f7fb;
  box-sizing: border-box;
}
.login-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.login-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #425bd8;
  color: #fff;
  font-size: 34rpx;
}
.login-welcome {
  margin: 100rpx 0 46rpx;
}
.login-heading {
  font-size: 58rpx;
  font-weight: 650;
  letter-spacing: -2rpx;
  color: #25334d;
}
.login-card {
  padding: 40rpx 32rpx;
}
.input-group {
  margin-bottom: 32rpx;
}
.label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: #72819a;
  margin-bottom: 16rpx;
}
.input-box {
  height: 90rpx;
  background: #f8faff;
  border: 1rpx solid #e1e7f1;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
}
.login-btn {
  margin-top: 38rpx;
  height: 88rpx;
  line-height: 88rpx;
  box-shadow: none;
  background: #425bd8;
  border-radius: 16rpx;
  font-size: 27rpx;
}
.login-note {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #a0aabb;
  margin-top: 26rpx;
}
.login-footer {
  text-align: center;
  font-size: 20rpx;
  color: #a1acbd;
  margin: 46rpx 0;
}
