.profile-identity {
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.profile-monogram {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #eef2ff;
  color: #526ccd;
  font-size: 42rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.name {
  font-size: 34rpx;
  font-weight: 600;
}
.identity-badge {
  font-size: 18rpx;
  color: #778ace;
  background: #f0f3ff;
  padding: 5rpx 12rpx;
  border-radius: 6rpx;
}
.student-no {
  display: block;
  font-size: 22rpx;
  color: #9ca6b7;
  margin: 12rpx 0 8rpx;
}
.profile-major {
  font-size: 22rpx;
  color: #7c8da5;
}
.board-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.board-caption {
  font-size: 20rpx;
  color: #9ba6b8;
  line-height: 1.7;
}
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 30rpx 0 12rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-left: 16rpx;
}
.stat-item + .stat-item {
  border-left: 1rpx solid #e9edf4;
  padding-left: 40rpx;
}
.stat-num {
  font-size: 44rpx;
  color: #334967;
  font-weight: 600;
}
.stat-name {
  font-size: 22rpx;
  color: #9ca6b7;
}
.course-dropdown {
  margin-top: 22rpx;
  border-top: 1rpx solid #e9edf4;
}
.course-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 23rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eff2f7;
  color: #71809a;
}
.c-credit {
  color: #9ca8b9;
}
.logout-btn {
  margin-top: 36rpx;
  background: #fff;
  color: #9c6666;
  border: 1rpx solid #ece2e2;
  line-height: 84rpx;
  font-size: 26rpx;
}
.profile-privacy {
  display: block;
  text-align: center;
  color: #a4adbd;
  font-size: 20rpx;
  margin-top: 24rpx;
}
