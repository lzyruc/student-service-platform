.upload-section { display: flex; flex-direction: column; align-items: center; text-align: center; }
.upload-info { display: flex; flex-direction: column; align-items: center; }
.u-title { font-size: 40rpx; font-weight: bold; color: var(--c-primary); margin-bottom: 10rpx; }
.u-sub { font-size: 26rpx; color: #999; line-height: 1.6; margin-bottom: 40rpx; }
.btn-primary { background: var(--grad-1); color: #fff; border-radius: 50rpx; width: 80%; box-shadow: 0 10rpx 20rpx rgba(21,125,236,0.3); }
.report-section { position: relative; margin-top: 30rpx; }
.risk-badge { display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 26rpx; font-weight: bold; margin-bottom: 20rpx; }
.safe { background: #E8F5E9; color: #4CAF50; }
.danger { background: #FFEBEE; color: #F44336; }
.divider { height: 1px; background: #eee; margin: 30rpx 0; }
.info-row { display: flex; justify-content: space-between; margin-bottom: 30rpx; font-size: 30rpx; }
.i-label { color: #666; font-weight: bold;}
.danger-text { color: #E53935; font-weight: bold; font-size: 34rpx;}
.suggestion-box { padding: 30rpx; border-radius: 24rpx; background: #f8faff; border: 1px solid #e2e8f0; color: #333; }
.s-title { font-weight: bold; margin-bottom: 16rpx; color: var(--c-primary); }
.s-text { font-size: 28rpx; line-height: 1.6; color: #555; }