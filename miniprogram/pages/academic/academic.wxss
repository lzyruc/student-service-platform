.upload-section {
  text-align: left;
}
.upload-info {
  width: 100%;
}
.u-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #34435e;
  margin-bottom: 14rpx;
}
.u-sub {
  font-size: 23rpx;
  color: #95a1b6;
  line-height: 1.8;
  margin-bottom: 26rpx;
}
.transcript-status {
  padding: 24rpx;
  background: #f7f9fd;
  border: 1rpx solid #e8edf5;
  border-radius: 14rpx;
  font-size: 23rpx;
  color: #72829c;
  line-height: 1.8;
  margin: 22rpx 0;
  word-break: break-all;
}
.transcript-time {
  font-size: 20rpx;
  color: #9aa6bb;
  margin-top: 10rpx;
}
.transcript-error {
  font-size: 23rpx;
  color: #b17b2d;
  line-height: 1.8;
  margin-bottom: 20rpx;
}
.btn-primary {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 14rpx;
  box-shadow: none;
}
.btn-upload {
  width: 100%;
  background: #f0f3fc;
  color: #526bc5;
  font-size: 26rpx;
  line-height: 80rpx;
  margin-top: 16rpx;
  border-radius: 14rpx;
}
.btn-reload {
  font-size: 23rpx;
  background: none;
  color: #7b8fc8;
  margin-top: 14rpx;
}
.risk-badge {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 500;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
}
.safe {
  color: #288268;
  background: #eaf7f1;
}
.warning {
  color: #a77830;
  background: #fff5e7;
}
.danger {
  color: #bf5c5c;
  background: #fff0f0;
}
.divider {
  height: 1rpx;
  background: #e8edf5;
  margin: 28rpx 0;
}
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 24rpx;
  margin-bottom: 26rpx;
}
.i-label {
  color: #8a98af;
}
.i-value {
  color: #384c70;
  font-weight: 600;
  font-size: 28rpx;
}
.danger-text {
  color: #b8793d;
}
.suggestion-box {
  background: #f7f9fd;
  padding: 26rpx;
  border: 1rpx solid #e6edf6;
  border-radius: 16rpx;
  margin-top: 30rpx;
}
.s-title {
  color: #5671ac;
  font-size: 25rpx;
  font-weight: 500;
  margin-bottom: 18rpx;
}
.s-text {
  color: #8592a9;
  font-size: 23rpx;
  line-height: 1.9;
  margin-bottom: 14rpx;
}

.risk-badge.unknown { color: #7b879c; background: #edf0f5; }
