<view class="container">
  <view class="glass-card">
    <view class="form-title">电子证明自动生成</view>
    
    <view class="form-item">
      <text class="f-label">证明类型</text>
      <picker bindchange="bindAutoTypeChange" value="{{autoTypeIndex}}" range="{{autoCertTypes}}">
        <view class="f-picker">{{autoCertTypes[autoTypeIndex]}} ▼</view>
      </picker>
    </view>
    
    <view class="tip-box">
      <text class="tip-text">系统会自动读取姓名、学号、身份证号、入党/入团时间、党支部或团员编号，并套用标准模板生成证明。</text>
    </view>
    
    <button class="btn-primary grad-1 mt-20" bindtap="submitAutoCert">立即生成</button>
  </view>

  <view class="glass-card mt-30">
    <view class="form-title">需审批证明申请</view>

    <view class="form-item">
      <text class="f-label">证明类型</text>
      <picker bindchange="bindApprovalTypeChange" value="{{approvalTypeIndex}}" range="{{approvalCertTypes}}">
        <view class="f-picker">{{approvalCertTypes[approvalTypeIndex]}} ▼</view>
      </picker>
    </view>

    <view class="form-item">
      <text class="f-label">事由（必填）</text>
      <textarea class="f-textarea" placeholder="请填写申请事由，用于老师审批" value="{{approvalReason}}" bindinput="onApprovalReasonInput"></textarea>
    </view>

    <view class="form-item">
      <text class="f-label">时间范围（可选）</text>
      <view class="date-row">
        <picker mode="date" value="{{approvalStartDate}}" bindchange="onApprovalStartDateChange">
          <view class="f-picker date-picker">{{approvalStartDate ? approvalStartDate : '开始日期'}}</view>
        </picker>
        <picker mode="date" value="{{approvalEndDate}}" bindchange="onApprovalEndDateChange">
          <view class="f-picker date-picker">{{approvalEndDate ? approvalEndDate : '结束日期'}}</view>
        </picker>
      </view>
    </view>

    <view class="tip-box">
      <text class="tip-text">提交后会进入待审核</text>
    </view>

    <button class="btn-primary grad-1 mt-20" bindtap="submitApprovalCert">提交申请（进入待审核）</button>
  </view>

  <view class="glass-card mt-30">
    <view class="form-title" style="margin-bottom: 20rpx; font-size: 30rpx;">📜 我的证明记录</view>

    <view class="history-subtitle">无需审核记录</view>
    <view class="history-list">
      <view class="history-block" wx:for="{{autoGeneratedList}}" wx:key="id">
        <view class="history-item">
          <view class="h-left">
            <text class="h-type">{{item.certificateType}}</text>
            <text class="h-time">{{item.createdAt}}</text>
          </view>
          <view class="h-right">
            <text class="h-status passed">已生成</text>
            <text class="h-download" catchtap="downloadAutoCert" data-type="{{item.certificateType}}">下载证明</text>
          </view>
        </view>
      </view>
      <view wx:if="{{autoGeneratedList.length === 0}}" style="text-align:center; color:#999; font-size:24rpx; padding: 20rpx 0;">暂无记录</view>
    </view>

    <view class="history-subtitle mt-20">需审批记录</view>
    <view class="history-list">
      <view class="history-block" wx:for="{{approvalHistoryList}}" wx:key="id">
        <view class="history-item" bindtap="toggleReason" data-id="{{item.id}}">
          <view class="h-left">
            <text class="h-type">{{item.certificateType}}</text>
            <text class="h-time">{{item.createdAt}}</text>
          </view>
          <view class="h-right">
            <text class="h-status {{item.applyStatus === '已通过' || item.applyStatus === '已生成' ? 'passed' : (item.applyStatus === '待审核' ? 'pending' : 'rejected')}}">{{item.applyStatus}}</text>
            <text class="h-download" wx:if="{{(item.applyStatus === '已通过' || item.applyStatus === '已生成') && item.fileId}}" catchtap="downloadCert" data-fileid="{{item.fileId}}">下载证明</text>
          </view>
        </view>
        <view class="reason-panel" wx:if="{{expandedCertId === item.id}}">
          <text class="reason-label">申请信息</text>
          <text class="reason-text">{{item.extraData || '无'}}</text>
        </view>
      </view>
      <view wx:if="{{approvalHistoryList.length === 0}}" style="text-align:center; color:#999; font-size:24rpx; padding: 20rpx 0;">暂无记录</view>
    </view>
  </view>
</view>
