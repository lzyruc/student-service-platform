page { height: 100%; }
.agent-page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; }
.agent-header { padding: 26rpx 30rpx 20rpx; background: #fff; flex-shrink: 0; }
.agent-heading-row { display: flex; align-items: center; justify-content: space-between; }
.agent-heading { font-size: 36rpx; font-weight: 700; color: #173655; }
.reset-button { margin: 0; padding: 0 20rpx; line-height: 58rpx; background: #eff5fd; color: #2475cc; font-size: 24rpx; border-radius: 18rpx; }
.reset-button::after, .suggestion-button::after, .agent-send::after { border: none; }
.agent-description { display: block; font-size: 23rpx; line-height: 1.5; color: #7a899b; margin-top: 12rpx; }
.transcript-link { display: inline-block; font-size: 24rpx; color: #157dec; padding-top: 16rpx; }
.transcript-link text { margin-left: 12rpx; }
.agent-chat { flex: 1; height: 0; min-height: 0; }
.chat-content { padding: 26rpx 28rpx 0; }
.suggestions { margin-bottom: 28rpx; }
.suggestions-title { display: block; color: #8390a0; font-size: 23rpx; margin-bottom: 14rpx; }
.suggestion-button { display: inline-block; margin: 0 12rpx 12rpx 0; padding: 0 22rpx; background: #fff; border-radius: 22rpx; line-height: 64rpx; font-size: 24rpx; color: #315579; }
.agent-message { display: flex; margin-bottom: 24rpx; }
.message-user { justify-content: flex-end; }
.message-assistant { justify-content: flex-start; }
.message-bubble { max-width: 88%; box-sizing: border-box; padding: 24rpx 26rpx; border-radius: 26rpx; font-size: 28rpx; line-height: 1.7; overflow-wrap: break-word; word-break: break-word; }
.message-user .message-bubble { background: #157dec; color: #fff; border-bottom-right-radius: 6rpx; }
.message-assistant .message-bubble { background: #fff; color: #34475b; border-bottom-left-radius: 6rpx; }
.message-text { white-space: pre-wrap; }
.message-notice { display: block; color: #9b6c22; font-size: 23rpx; margin-bottom: 10rpx; }
.thinking { color: #72849b; font-size: 25rpx; padding: 8rpx 8rpx 24rpx; }
.chat-end { height: 20rpx; }
.agent-composer { display: flex; align-items: flex-end; flex-shrink: 0; padding: 20rpx 24rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #e7eef7; }
.question-input { flex: 1; width: 0; min-height: 72rpx; max-height: 180rpx; padding: 18rpx 22rpx; box-sizing: border-box; border-radius: 24rpx; background: #f3f6fa; color: #34475b; font-size: 27rpx; line-height: 36rpx; }
.agent-send { flex-shrink: 0; width: 150rpx; height: 78rpx; line-height: 78rpx; margin: 0 0 0 16rpx; padding: 0; background: #157dec; color: #fff; font-size: 26rpx; border-radius: 24rpx; }
.agent-send[disabled] { background: #bad5f3; color: #fff; }
