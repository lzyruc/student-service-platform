page {
  --c-primary: #157DEC;
  --c-secondary: #1589FF;
  --c-accent1: #56A5EC;
  --c-accent2: #5CB3FF;
  
  --grad-1: linear-gradient(135deg, var(--c-primary) 0%, var(--c-secondary) 100%);
  --grad-2: linear-gradient(135deg, var(--c-secondary) 0%, var(--c-accent1) 100%);
  --grad-3: linear-gradient(135deg, var(--c-accent1) 0%, var(--c-accent2) 100%);
  --grad-4: linear-gradient(135deg, var(--c-accent2) 0%, var(--c-primary) 100%);

  background-color: #F4F7FD;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.container { padding: 30rpx; box-sizing: border-box; }

.glass-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  border-radius: 32rpx;
  box-shadow: 0 16rpx 40rpx rgba(21, 125, 236, 0.08);
  padding: 40rpx;
  margin-bottom: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.5);
}