page {
  --c-primary: #425bd8;
  --c-secondary: #657bdd;
  --c-accent1: #8496e8;
  --c-accent2: #a0ade9;
  --c-text: #202c43;
  --c-muted: #8290a6;
  --c-line: #e7ecf4;
  --grad-1: #425bd8;
  --grad-2: #657bdd;
  --grad-3: #425bd8;
  --grad-4: #eef2ff;
  background: #f5f7fb;
  color: var(--c-text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}
.container {
  padding: 36rpx 32rpx;
  box-sizing: border-box;
}
.glass-card,
.surface-card {
  background: #fff;
  border: 1rpx solid var(--c-line);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(32, 49, 85, 0.025);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}
button::after {
  border: none;
}
button {
  font-weight: 500;
  border-radius: 16rpx;
  font-size: 26rpx;
}
button[disabled] {
  opacity: 0.5;
}
.btn-primary {
  background: var(--c-primary);
  color: #fff;
  border-radius: 16rpx;
  box-shadow: none;
  line-height: 88rpx;
  font-size: 28rpx;
}
.page-eyebrow {
  display: block;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  font-weight: 600;
  color: var(--c-primary);
  margin-bottom: 16rpx;
}
.page-title {
  display: block;
  font-size: 44rpx;
  letter-spacing: -1rpx;
  font-weight: 650;
  line-height: 1.4;
}
.page-description {
  display: block;
  color: var(--c-muted);
  font-size: 24rpx;
  line-height: 1.8;
  margin-top: 12rpx;
  margin-bottom: 30rpx;
}
.empty-state {
  padding: 44rpx 24rpx;
  text-align: center;
  color: var(--c-muted);
  font-size: 26rpx;
  line-height: 1.8;
}
.empty-symbol {
  display: block;
  font-size: 42rpx;
  color: #abb7cf;
  margin-bottom: 12rpx;
}
.error-state {
  padding: 24rpx;
  border: 1rpx solid #f2d8b5;
  border-radius: 16rpx;
  background: #fff9ef;
  color: #9f712e;
  line-height: 1.7;
  font-size: 24rpx;
  margin: 16rpx 0;
}
.error-state button {
  margin-top: 12rpx;
  font-size: 24rpx;
  background: #fff;
  color: #9f712e;
}
.skeleton {
  height: 24rpx;
  border-radius: 6rpx;
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #edf0f5, #f7f9fc, #edf0f5);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
.skeleton-lg {
  height: 48rpx;
  width: 60%;
}
.skeleton-sm {
  width: 40%;
}
@keyframes shimmer {
  from {
    background-position: 100% 0;
  }
  to {
    background-position: -100% 0;
  }
}
